{
  "name": "official-community-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Community plugins for OSC Flow Studio, published together through one catalog",
  "repository": {
    "type": "git",
    "url": "https://github.com/OSC-Flow-Studio/official-community-plugins.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"plugins/*/tests/*.test.mjs\"",
    "test:host-contract": "node --experimental-strip-types --test \"plugins/*/tests/host/*.test.mjs\"",
    "check": "npm run validate && npm test",
    "prepackage": "npm run check",
    "package": "node scripts/package.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "release": "node scripts/release-plugin.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "picocolors": "1.1.1",
    "ws": "8.21.3"
  }
}
