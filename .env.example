# Signing key for official plugin releases. Copy this file to .env, or run
# `npm run keygen` to create .env with a new key. Never commit .env.
#
# The release command signs each plugin ZIP with this key on your machine. The
# matching public key lives in scripts/official-keys.json and in OSC Flow Studio,
# which shows a signed package as published by the OSC Flow Studio team.

# Name of the key, as listed in scripts/official-keys.json.
OFS_SIGNING_KEY_ID=

# Ed25519 private key, PKCS#8 DER encoded as base64 on one line.
OFS_SIGNING_PRIVATE_KEY=
